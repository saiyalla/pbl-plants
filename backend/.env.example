# Copy to .env and fill in. Never commit the real .env.

# Local dev uses SQLite. In production use Postgres, e.g.
# DATABASE_URL=postgresql+psycopg://pbl:password@db-host:5432/pbl
DATABASE_URL=sqlite:///./pbl.db

# The Next.js site's URL(s), comma-separated
FRONTEND_ORIGINS=http://localhost:3000

# Minimum order value. Which pincodes are deliverable, their distance, and the delivery-fee
# formula are managed from the admin panel (Delivery tab), not here.
MIN_ORDER_PAISE=0

# Admin panel login. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Razorpay (Dashboard → Account & Settings → API Keys / Webhooks). Leave empty to run COD-only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional: new-order alerts in a Telegram group for the delivery team
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
